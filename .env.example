# ---------- Auth ----------
# Any long random string (min 32 chars). Generate: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-secret

# First super admin. Used to create the account on first login (when no users exist)
# and as a recovery login: if you change SUPERADMIN_PASSWORD here and sign in with it,
# the super admin's password is reset to the new value.
SUPERADMIN_EMAIL=you@example.com
SUPERADMIN_PASSWORD=change-me

# ---------- Supabase (Dashboard -> Settings -> API Keys) ----------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Secret key. New projects: sb_secret_... (tab "Publishable and secret API keys").
# Older projects may still use the legacy service_role key (eyJ...). Both work.
# Server only - never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ---------- Cloudflare R2 (R2 -> Manage R2 API Tokens) ----------
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=pdf-files

# ---------- Optional ----------
# redirect (default): visitor is sent to a short-lived R2 URL; free R2 egress, no Vercel bandwidth.
# proxy: file is streamed through Vercel (URL stays on your domain; uses Vercel bandwidth).
DOWNLOAD_MODE=redirect

# Max upload size in MB (direct browser -> R2 upload). Default 200.
MAX_UPLOAD_MB=200

# Restrict the admin panel + login to these hostnames (comma separated).
# Leave empty to allow /admin on every attached domain. Include localhost for local dev.
ADMIN_HOSTS=

# Vercel API (optional) — lets the admin panel attach domains/subdomains to this project.
# Token: Vercel -> Account Settings -> Tokens. Project ID: Project -> Settings -> General.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
